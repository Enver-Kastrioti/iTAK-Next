#!/usr/bin/env bash
# iTAK Next launcher.
#
# Preferred command-line entry point. It keeps the invocation stable (./itaknext)
# even if the implementation file changes, and it automatically reuses the local
# runtime prepared by ./install_runtime.sh when one is available.

set -euo pipefail

# Resolve symlinks so the launcher also works when linked into PATH, e.g.
#   ln -s "$PWD/itaknext" /usr/local/bin/itaknext
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
    SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$SOURCE_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
ENTRY_SCRIPT="$SCRIPT_DIR/itaknext.py"

# 1) Explicit interpreter override, e.g. PYTHON=/path/to/venv/bin/python ./itaknext ...
if [[ -n "${PYTHON:-}" ]]; then
    exec "$PYTHON" "$ENTRY_SCRIPT" "$@"
fi

# 2) Local runtime generated by ./install_runtime.sh (JAVA_HOME / InterProScan env)
if [[ -x "$SCRIPT_DIR/run_itaknext_local.sh" ]]; then
    exec "$SCRIPT_DIR/run_itaknext_local.sh" "$@"
fi

# 3) Project virtualenv
if [[ -x "$SCRIPT_DIR/.venv/bin/python" ]]; then
    exec "$SCRIPT_DIR/.venv/bin/python" "$ENTRY_SCRIPT" "$@"
fi

# 4) Interpreter from PATH
if command -v python3 >/dev/null 2>&1; then
    exec python3 "$ENTRY_SCRIPT" "$@"
fi
if command -v python >/dev/null 2>&1; then
    exec python "$ENTRY_SCRIPT" "$@"
fi

echo "Error: no Python interpreter found. Install Python 3.7+ or set PYTHON=/path/to/python3" >&2
exit 1
